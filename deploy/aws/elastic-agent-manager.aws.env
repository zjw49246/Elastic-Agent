# Non-secret production settings for account 297645381734, ap-northeast-1.
# Secrets remain in /etc/elastic-agent-manager.env.
ELASTIC_AGENT_AWS_REGION=ap-northeast-1
ELASTIC_AGENT_AWS_AMI_ID=ami-0aec7ffcbe44c6f7a
ELASTIC_AGENT_AWS_INSTANCE_TYPE=t3.large
ELASTIC_AGENT_AWS_WORKER_SECURITY_GROUP_IDS=sg-05c68220f901fb555
ELASTIC_AGENT_AWS_SUBNET_ID=subnet-0c1db80817d054277
ELASTIC_AGENT_AWS_KEY_PAIR_NAME=interview-key
ELASTIC_AGENT_AWS_SSH_KEY_PATH=/home/ubuntu/.ssh/interview-key.pem
ELASTIC_AGENT_AWS_WORKER_INSTANCE_PROFILE=elastic-agent-worker
ELASTIC_AGENT_AWS_EXPECTED_ROLE_NAME=elastic-agent-manager
ELASTIC_AGENT_AWS_MAX_INSTANCES=800
# Across all JobBatch manifests; each manifest remains capped at 10 active Jobs.
ELASTIC_AGENT_JOB_BATCH_MAX_ACTIVE_JOBS=800
# Bound fleet bring-up and periodic collection bursts independently of the
# eventual 800-Worker steady-state target.
ELASTIC_AGENT_WORKER_BRINGUP_CONCURRENCY=32
ELASTIC_AGENT_PERIODIC_COLLECT_CONCURRENCY=32
ELASTIC_AGENT_PERIODIC_COLLECT_JITTER_RATIO=0.25
ELASTIC_AGENT_STATE_DIR=/home/ubuntu/.elastic-agent-demo
ELASTIC_AGENT_PUBLIC_ORIGIN=https://elastic-agent.claude-code-manager.com
ELASTIC_AGENT_FRAMEWORK_SRC=/home/ubuntu/elastic-agent/src
ELASTIC_AGENT_SERVER_HOST=0.0.0.0
ELASTIC_AGENT_SERVER_PORT=8080
ELASTIC_AGENT_WORKER_SSH_USER=ubuntu
ELASTIC_AGENT_LOG_LEVEL=INFO
ELASTIC_AGENT_RESULTS_S3_BUCKET=elastic-agent-results-297645381734
ELASTIC_AGENT_RESULTS_S3_PREFIX=jobs
ELASTIC_AGENT_RESULTS_S3_INTERVAL=60
# Workers in this deployment upload collections directly through their IAM
# instance profile. Keep awaited per-Job/final uploads available, but disable
# the redundant 24 GiB Manager whole-tree scan that already exceeds 240 s.
ELASTIC_AGENT_RESULTS_S3_PERIODIC_ENABLED=false
# Common Tokyo x86_64 Worker shapes; T3 ends at 2xlarge.
ELASTIC_AGENT_ALLOWED_INSTANCE_TYPES=t3.large,t3.xlarge,t3.2xlarge,m5.large,m5.xlarge,m5.2xlarge,m5.4xlarge,m6i.large,m6i.xlarge,m6i.2xlarge,m6i.4xlarge,m7i.large,m7i.xlarge,m7i.2xlarge,m7i.4xlarge,c5.large,c5.xlarge,c5.2xlarge,c5.4xlarge,c6i.large,c6i.xlarge,c6i.2xlarge,c6i.4xlarge,c7i.large,c7i.xlarge,c7i.2xlarge,c7i.4xlarge,r5.large,r5.xlarge,r5.2xlarge,r5.4xlarge,r6i.large,r6i.xlarge,r6i.2xlarge,r6i.4xlarge,r7i.large,r7i.xlarge,r7i.2xlarge,r7i.4xlarge
