{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LocateResultsBucket",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::elastic-agent-results-297645381734"
    },
    {
      "Sid": "ListOnlyJobDatasets",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::elastic-agent-results-297645381734",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "jobs/datasets",
            "jobs/datasets/",
            "jobs/datasets/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadOnlyJobDatasets",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::elastic-agent-results-297645381734/jobs/datasets/*"
    },
    {
      "Sid": "WriteOnlyResultsObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::elastic-agent-results-297645381734/jobs/*"
    }
  ]
}
