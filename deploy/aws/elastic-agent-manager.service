[Unit]
Description=Elastic-Agent AWS Manager
After=network-online.target
Wants=network-online.target
AssertPathIsDirectory=/home/ubuntu/.elastic-agent-demo

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/task-platform/elastic-agent-e06ac35dedf4e876ab42ef2cf83161948c09cf87
EnvironmentFile=/etc/elastic-agent-manager.env
EnvironmentFile=/etc/elastic-agent-manager.aws.env
Environment=PYTHONUNBUFFERED=1
Environment=AWS_SHARED_CREDENTIALS_FILE=/dev/null
Environment=AWS_CONFIG_FILE=/dev/null
Environment=BOTO_CONFIG=/dev/null
Environment=AWS_EC2_METADATA_DISABLED=false
Environment=AWS_EC2_METADATA_V1_DISABLED=true
UnsetEnvironment=AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_SECURITY_TOKEN AWS_PROFILE AWS_DEFAULT_PROFILE AWS_WEB_IDENTITY_TOKEN_FILE AWS_ROLE_ARN AWS_ROLE_SESSION_NAME AWS_CONTAINER_CREDENTIALS_RELATIVE_URI AWS_CONTAINER_CREDENTIALS_FULL_URI AWS_CONTAINER_AUTHORIZATION_TOKEN AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE AWS_EC2_METADATA_SERVICE_ENDPOINT AWS_ENDPOINT_URL AWS_ENDPOINT_URL_STS AWS_ENDPOINT_URL_EC2 AWS_ENDPOINT_URL_S3 AWS_ENDPOINT_URL_SECRETSMANAGER AWS_ENDPOINT_URL_SSM
ExecStart=/opt/task-platform/elastic-agent-e06ac35dedf4e876ab42ef2cf83161948c09cf87/.venv/bin/python /opt/task-platform/elastic-agent-e06ac35dedf4e876ab42ef2cf83161948c09cf87/deploy/aws_manager.py
# Health is an authenticated management endpoint.  Readiness passes the first
# configured service token through curl's stdin so it never appears in argv.
ExecStartPost=/bin/sh -c 'for attempt in $(seq 1 240); do printf "Authorization: Bearer %s\n" "${ELASTIC_AGENT_EXTERNAL_API_KEYS%%,*}" | /usr/bin/curl -fsS -H @- http://127.0.0.1:8080/api/health >/dev/null && exit 0; sleep 1; done; exit 1'
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=32400
UMask=0077

# The Manager needs network access and one state directory, but it does not
# need to mutate its release, SSH key, host configuration, or kernel state.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.elastic-agent-demo
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
