{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadControllerEc2State",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAddresses",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeImages",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1"
        }
      }
    },
    {
      "Sid": "LaunchWithPinnedInfrastructure",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:ap-northeast-1::image/ami-0aec7ffcbe44c6f7a",
        "arn:aws:ec2:ap-northeast-1:297645381734:subnet/subnet-0c1db80817d054277",
        "arn:aws:ec2:ap-northeast-1:297645381734:security-group/sg-05c68220f901fb555",
        "arn:aws:ec2:ap-northeast-1:297645381734:key-pair/interview-key",
        "arn:aws:ec2:ap-northeast-1:297645381734:network-interface/*",
        "arn:aws:ec2:ap-northeast-1:297645381734:spot-instances-request/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1"
        }
      }
    },
    {
      "Sid": "LaunchEncryptedGp3Volumes",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ap-northeast-1:297645381734:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "ec2:VolumeType": "gp3"
        },
        "Bool": {
          "ec2:Encrypted": "true"
        },
        "NumericLessThanEquals": {
          "ec2:VolumeSize": "2048"
        }
      }
    },
    {
      "Sid": "LaunchOnlyManagedWorkers",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ap-northeast-1:297645381734:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "aws:RequestTag/ManagedBy": "elastic-agent",
          "ec2:InstanceType": "t3.large",
          "ec2:MetadataHttpTokens": "required"
        },
        "ArnEquals": {
          "ec2:InstanceProfile": "arn:aws:iam::297645381734:instance-profile/elastic-agent-worker"
        },
        "NumericEquals": {
          "ec2:MetadataHttpPutResponseHopLimit": "1"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "ManagedBy",
            "Name",
            "ElasticAgentJob",
            "ElasticAgentController",
            "ElasticAgentLease",
            "ElasticAgentAccount",
            "AccountId",
            "Role"
          ]
        }
      }
    },
    {
      "Sid": "TagManagedResourcesAtCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:ap-northeast-1:297645381734:instance/*",
        "arn:aws:ec2:ap-northeast-1:297645381734:network-interface/*",
        "arn:aws:ec2:ap-northeast-1:297645381734:elastic-ip/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "aws:RequestTag/ManagedBy": "elastic-agent",
          "ec2:CreateAction": [
            "RunInstances",
            "AllocateAddress"
          ]
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "ManagedBy",
            "Name",
            "ElasticAgentJob",
            "ElasticAgentController",
            "ElasticAgentLease",
            "ElasticAgentAccount",
            "AccountId",
            "Role"
          ]
        }
      }
    },
    {
      "Sid": "ManageOnlyTaggedWorkers",
      "Effect": "Allow",
      "Action": [
        "ec2:RebootInstances",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances"
      ],
      "Resource": "arn:aws:ec2:ap-northeast-1:297645381734:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "ec2:ResourceTag/ManagedBy": "elastic-agent"
        }
      }
    },
    {
      "Sid": "AllocateOnlyTaggedEips",
      "Effect": "Allow",
      "Action": "ec2:AllocateAddress",
      "Resource": "arn:aws:ec2:ap-northeast-1:297645381734:elastic-ip/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "aws:RequestTag/ManagedBy": "elastic-agent"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "ManagedBy",
            "ElasticAgentController",
            "AccountId",
            "Role"
          ]
        }
      }
    },
    {
      "Sid": "AttachManagedEipsToManagedWorkers",
      "Effect": "Allow",
      "Action": "ec2:AssociateAddress",
      "Resource": [
        "arn:aws:ec2:ap-northeast-1:297645381734:elastic-ip/*",
        "arn:aws:ec2:ap-northeast-1:297645381734:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "ec2:ResourceTag/ManagedBy": "elastic-agent"
        }
      }
    },
    {
      "Sid": "DisassociateManagedEips",
      "Effect": "Allow",
      "Action": "ec2:DisassociateAddress",
      "Resource": [
        "arn:aws:ec2:ap-northeast-1:297645381734:elastic-ip/*",
        "arn:aws:ec2:ap-northeast-1:297645381734:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "ec2:ResourceTag/ManagedBy": "elastic-agent"
        }
      }
    },
    {
      "Sid": "ReleaseManagedEips",
      "Effect": "Allow",
      "Action": "ec2:ReleaseAddress",
      "Resource": "arn:aws:ec2:ap-northeast-1:297645381734:elastic-ip/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "ec2:ResourceTag/ManagedBy": "elastic-agent"
        }
      }
    },
    {
      "Sid": "RetagOnlyManagedEips",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:ap-northeast-1:297645381734:elastic-ip/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "aws:RequestTag/ManagedBy": "elastic-agent",
          "ec2:ResourceTag/ManagedBy": "elastic-agent"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "ManagedBy",
            "ElasticAgentController",
            "AccountId",
            "Role"
          ]
        }
      }
    },
    {
      "Sid": "PassOnlyWorkerRoleToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::297645381734:role/elastic-agent-worker",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        },
        "ArnLike": {
          "iam:AssociatedResourceArn": "arn:aws:ec2:ap-northeast-1:297645381734:instance/*"
        }
      }
    },
    {
      "Sid": "UseDefaultEbsKey",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo"
      ],
      "Resource": "arn:aws:kms:ap-northeast-1:297645381734:key/94512b70-8710-409f-ae17-5770f7562668",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ec2.ap-northeast-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "CreateEbsGrantsForAwsResources",
      "Effect": "Allow",
      "Action": "kms:CreateGrant",
      "Resource": "arn:aws:kms:ap-northeast-1:297645381734:key/94512b70-8710-409f-ae17-5770f7562668",
      "Condition": {
        "Bool": {
          "kms:GrantIsForAWSResource": "true"
        },
        "StringEquals": {
          "kms:ViaService": "ec2.ap-northeast-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "LocateResultsBucket",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::elastic-agent-results-297645381734"
    },
    {
      "Sid": "ListResults",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::elastic-agent-results-297645381734",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "jobs",
            "jobs/",
            "jobs/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadAndWriteResults",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::elastic-agent-results-297645381734/jobs/*"
    },
    {
      "Sid": "ReadNamedJobSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:ap-northeast-1:297645381734:secret:elastic-agent/*"
    },
    {
      "Sid": "ReadNamedJobParameters",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:ap-northeast-1:297645381734:parameter/elastic-agent/*"
    },
    {
      "Sid": "IdentifyManagerAccount",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "SsmManagedNodeCore",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeAssociation",
        "ssm:GetDeployablePatchSnapshotForInstance",
        "ssm:GetDocument",
        "ssm:DescribeDocument",
        "ssm:GetManifest",
        "ssm:ListAssociations",
        "ssm:ListInstanceAssociations",
        "ssm:PutInventory",
        "ssm:PutComplianceItems",
        "ssm:PutConfigurePackageResult",
        "ssm:UpdateAssociationStatus",
        "ssm:UpdateInstanceAssociationStatus",
        "ssm:UpdateInstanceInformation",
        "ssmmessages:CreateControlChannel",
        "ssmmessages:CreateDataChannel",
        "ssmmessages:OpenControlChannel",
        "ssmmessages:OpenDataChannel",
        "ec2messages:AcknowledgeMessage",
        "ec2messages:DeleteMessage",
        "ec2messages:FailMessage",
        "ec2messages:GetEndpoint",
        "ec2messages:GetMessages",
        "ec2messages:SendReply"
      ],
      "Resource": "*"
    }
  ]
}
